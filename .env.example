PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/mi_base_datos
DATABASE_SSL=false
# Optional absolute path for product photos (<codigo>.jpg). Default: ./media/productos
# PRODUCT_IMAGES_DIR=/var/lib/electronica/productos

# SMTP para recuperación de contraseña (vacío = solo log del link en desarrollo)
# Ejemplo Gmail (App Password): smtp://tu.correo%40gmail.com:app-password@smtp.gmail.com:587
# SMTP_URL=smtp://usuario:clave@smtp.ejemplo.com:587
# MAIL_FROM=Electrónica Central AZ <noreply@tudominio.com>

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
BOOTSTRAP_DEVELOPER_USERNAME=soporte
BOOTSTRAP_DEVELOPER_EMAIL=soporte@example.test
BOOTSTRAP_DEVELOPER_PASSWORD=change-this-developer-password
